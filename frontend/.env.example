# Local dev only (.env.local) — do NOT set on Vercel:
NEXT_PUBLIC_API_URL=http://localhost:4000
# Dev proxy target (Next rewrites /api/proxy → API). Defaults to http://127.0.0.1:4000
# API_PROXY_TARGET=http://127.0.0.1:4000

# Dev-only: show quick-fill demo login buttons on /login and /admin/login (never enabled in production)
# NEXT_PUBLIC_ENABLE_DEMO_LOGIN=true

# Vercel production:
# - DELETE NEXT_PUBLIC_API_URL from Vercel env (never use localhost there)
# - API_PROXY_TARGET=http://80.225.219.189:4000
# - Optional sockets: NEXT_PUBLIC_SOCKET_URL=https://your-https-api-domain
