# Local (docker compose up -d db):
DATABASE_URL="postgresql://restaurant:restaurant@localhost:5432/restaurant_os?schema=public"
# Production (Render/Neon/Supabase): use the host's Postgres URL; add ssl if required:
# DATABASE_URL="postgresql://user:pass@host:5432/dbname?schema=public&sslmode=require"
RESTAURANT_ID="11111111-1111-4111-8111-111111111111"
# Required in production: openssl rand -hex 32
JWT_SECRET="change-me-in-production-use-32-plus-random-chars"
# Dev only: return JWT in login JSON (production uses HttpOnly cookie only)
# AUTH_TOKEN_IN_BODY=1
# Demo seed admin password (required when NODE_ENV=production)
# SEED_ADMIN_PASSWORD=
PORT=4000
# Comma-separated browser origins (required in production)
CLIENT_URL="http://localhost:3000,http://localhost:3001"

# Google Places — live reviews on homepage (enable Places API in Google Cloud)
GOOGLE_PLACES_API_KEY=""

# Email — Gmail App Password required (not your normal password)
# IMPORTANT for deliverability: SMTP_FROM must use the SAME email as SMTP_USER
SMTP_SERVICE="gmail"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your16charapppassword"
SMTP_FROM="Restaurant <your-email@gmail.com>"
SMTP_REPLY_TO="your-email@gmail.com"
# Extra inbox for new-order staff alerts (in addition to admin/chef accounts)
NOTIFY_EMAIL=""
# For best deliverability in production, use your own domain with SPF/DKIM/DMARC
# (e.g. Resend, SendGrid, or Google Workspace on your domain)

# Meta WhatsApp Cloud API — https://developers.facebook.com/docs/whatsapp/cloud-api
WHATSAPP_ENABLED="true"
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_API_VERSION="v21.0"
WHATSAPP_TEMPLATE_LANG="en"
# Kitchen alert number (defaults to store WhatsApp in admin settings)
WHATSAPP_NOTIFY_TO=""
# Approved templates in Meta Business Manager (required for first message to customers)
WHATSAPP_TEMPLATE_ORDER="order_received"
WHATSAPP_TEMPLATE_STAFF="new_order_alert"

# Optional — storefront order status web push (Task 5)
# Generate: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:ops@yourdomain.com
