generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// One deployment serves one restaurant. Every tenant row carries this id.
model Restaurant {
  id        String   @id
  hostname  String?  @unique
  createdAt DateTime @default(now())

  settings     StoreSettings?
  users        User[]
  categories   Category[]
  menuItems    MenuItem[]
  banners      PromoBanner[]
  deals        Deal[]
  areas        DeliveryArea[]
  branches     Branch[]
  orders       Order[]
  blocks       OrderBlock[]
  testimonials Testimonial[]
  suppliers            Supplier[]
  inventoryItems       InventoryItem[]
  ingredientCategories IngredientCategory[]
  coupons              Coupon[]
}

model Branch {
  id           String     @id @default(uuid())
  restaurantId String     @default("11111111-1111-4111-8111-111111111111")
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  name         String
  code         String
  address      String     @default("")
  phone        String     @default("")
  isActive     Boolean    @default(true)
  isDefault    Boolean    @default(false)
  sortOrder    Int        @default(0)
  timezone     String     @default("Asia/Karachi")
  graceMin     Int        @default(15)
  createdAt    DateTime   @default(now())
  orders         Order[]
  auditLogs      AuditLog[]
  members        BranchMember[]
  diningFloors   DiningFloor[]
  diningTables   DiningTable[]
  tableSessions  TableSession[]
  reservations   Reservation[]
  waitlistEntries WaitlistEntry[]
  branchStocks         BranchStock[]
  stockMovements       StockMovement[]
  inventoryPurchases   InventoryPurchase[]
  stockBatches         StockBatch[]
  wasteLogs            WasteLog[]
  stockCounts          StockCount[]
  transfersOut         StockTransfer[] @relation("TransferFrom")
  transfersIn          StockTransfer[] @relation("TransferTo")
  cashShifts           CashShift[]
  riderCashEntries     RiderCashEntry[]
  riderSettlements     RiderSettlement[]
  printStations        PrintStation[]
  branchCoupons        Coupon[]
  posOrderDayCounters  BranchPosOrderDayCounter[]
  taxInvoiceCounters   BranchTaxInvoiceCounter[]
  posHolds             PosHold[]
  menuItemAvailability MenuItemBranchAvailability[]
  dealAvailability     DealBranchAvailability[]

  @@unique([restaurantId, code])
  @@index([restaurantId, isActive])
}

model BranchPosOrderDayCounter {
  id       String @id @default(uuid())
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  dayKey   String
  lastSeq  Int    @default(1000)

  @@unique([branchId, dayKey])
}

model BranchTaxInvoiceCounter {
  id         String @id @default(uuid())
  branchId   String
  branch     Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  fiscalYear Int    @default(0)
  lastSeq    Int    @default(0)

  @@unique([branchId, fiscalYear])
}

enum FiscalSubmissionStatus {
  NOT_REQUIRED
  PENDING
  SUBMITTED
  FAILED
}

model BranchMember {
  id       String @id @default(uuid())
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([branchId, userId])
  @@index([userId])
}

enum Role {
  CUSTOMER
  ADMIN
  MANAGER
  WAITER
  RIDER
  CHEF
  CASHIER
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  NEEDS_CLEANING
}

enum SeatType {
  TABLE
  TAKHT
  BOOTH
  HIGH_TOP
  OUTDOOR
}

enum TableSessionStatus {
  OPEN
  CLOSED
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  REJECTED
  SEATED
  CANCELLED
  NO_SHOW
  COMPLETED
}

enum WaitlistStatus {
  WAITING
  CALLED
  SEATED
  CANCELLED
  LEFT
}

enum InventoryUnit {
  KG
  G
  L
  ML
  PIECE
  PACK
  DOZEN
}

enum StockMovementType {
  PURCHASE
  ADJUSTMENT
  WASTE
  SALE
  SALE_DEDUCTION
  COUNT
  COUNT_CORRECTION
  TRANSFER_IN
  TRANSFER_OUT
  REVERSAL
}

enum PurchasePaymentStatus {
  UNPAID
  PARTIAL
  PAID
}

enum PurchaseStatus {
  DRAFT
  RECEIVED
  VOIDED
}

enum WasteReason {
  EXPIRED
  SPOILED
  DROPPED
  OVER_PREPARED
  STAFF_MEAL
  OTHER
}

enum StockCountStatus {
  DRAFT
  SUBMITTED
  APPROVED
}

enum TransferStatus {
  PENDING
  IN_TRANSIT
  RECEIVED
  CANCELLED
}

enum StockReferenceType {
  ORDER
  PURCHASE
  WASTE
  COUNT
  TRANSFER
  ADJUSTMENT
}

enum OrderSource {
  ONLINE
  POS
}

enum PaymentMethod {
  CASH
  CARD
}

enum OrderStatus {
  PENDING_CONFIRMATION
  CONFIRMED
  PREPARING
  READY
  OUT_FOR_DELIVERY
  DELIVERED
  COLLECTED
  SERVED
  CANCELLED
}

enum FulfillmentType {
  DELIVERY
  PICKUP
  DINE_IN
}

model User {
  id           String   @id @default(uuid())
  restaurantId String   @default("11111111-1111-4111-8111-111111111111")
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  name         String
  email        String   @unique
  passwordHash String
  role         Role
  phone        String?
  isActive     Boolean  @default(true)
  totpSecret           String?
  totpEnabled          Boolean   @default(false)
  recoveryCodes        String?
  tokenVersion         Int       @default(0)
  failedLoginCount     Int       @default(0)
  lockedUntil          DateTime?
  approvalPinHash      String?
  approvalPinFailedCount Int     @default(0)
  approvalPinLockedUntil DateTime?
  lastLoginAt          DateTime?
  passwordResetToken   String?
  passwordResetExpires DateTime?
  createdAt            DateTime  @default(now())

  orders          Order[]        @relation("CustomerOrders")
  assignedOrders  Order[]        @relation("RiderOrders")
  posOrders       Order[]        @relation("PosOrders")
  waiterOrders    Order[]        @relation("WaiterOrders")
  waiterSessions       TableSession[] @relation("WaiterSessions")
  branchMembers        BranchMember[]
  confirmedReservations Reservation[] @relation("ReservationConfirmedBy")
  auditLogs            AuditLog[]
  ordersAdjustmentRequested Order[] @relation("OrderAdjRequester")
  ordersAdjustmentApproved  Order[] @relation("OrderAdjApprover")
  ordersVoidApproved        Order[] @relation("OrderVoidApprover")
  ordersRefundApproved      Order[] @relation("OrderRefundApprover")
  cashShifts                CashShift[] @relation("CashierShifts")
  cashMovementsCreated      CashMovement[] @relation("CashMovementCreator")
  riderCashEntries          RiderCashEntry[] @relation("RiderCashEntries")
  riderSettlementsReceived  RiderSettlement[] @relation("RiderSettlementsRider")
  riderSettlementsSettled   RiderSettlement[] @relation("RiderSettlementsSettledBy")
  loyaltyPoints             Int               @default(0)
  pushSubscriptions         CustomerPushSubscription[]
  posHolds                  PosHold[]
}

model DiningFloor {
  id        String        @id @default(uuid())
  branchId  String
  branch    Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  name      String
  sortOrder Int           @default(0)
  createdAt DateTime      @default(now())
  tables    DiningTable[]

  @@unique([branchId, name])
  @@index([branchId, sortOrder])
}

model DiningTable {
  id           String      @id @default(uuid())
  branchId     String
  branch       Branch      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  floorId      String?
  floor        DiningFloor? @relation(fields: [floorId], references: [id], onDelete: SetNull)
  label        String
  capacity     Int         @default(4)
  seatType     SeatType    @default(TABLE)
  zone         String      @default("")
  status       TableStatus @default(AVAILABLE)
  sortOrder    Int         @default(0)
  createdAt    DateTime    @default(now())
  sessions     TableSession[]
  reservations Reservation[]
  orders       Order[]
  waitlistPreferred WaitlistEntry[] @relation("WaitlistPreferredTable")

  @@unique([branchId, label])
  @@index([branchId, status])
  @@index([floorId])
}

model TableSession {
  id            String             @id @default(uuid())
  branchId      String
  branch        Branch             @relation(fields: [branchId], references: [id], onDelete: Cascade)
  tableId       String
  table         DiningTable        @relation(fields: [tableId], references: [id], onDelete: Cascade)
  waiterId      String?
  waiter        User?              @relation("WaiterSessions", fields: [waiterId], references: [id])
  guestName     String             @default("Walk-in")
  partySize     Int                @default(2)
  status        TableSessionStatus @default(OPEN)
  notes         String?
  openedAt      DateTime           @default(now())
  closedAt      DateTime?
  reservationId String?            @unique
  reservation   Reservation?       @relation(fields: [reservationId], references: [id])
  orders        Order[]

  @@index([branchId, status])
  @@index([tableId, status])
}

model Reservation {
  id                 String            @id @default(uuid())
  branchId           String
  branch             Branch            @relation(fields: [branchId], references: [id], onDelete: Cascade)
  tableId            String?
  table              DiningTable?      @relation(fields: [tableId], references: [id])
  guestName          String
  guestPhone         String
  guestEmail         String
  emailMissingLegacy Boolean           @default(false)
  partySize          Int               @default(2)
  startsAt           DateTime
  durationMin        Int               @default(90)
  status             ReservationStatus @default(PENDING)
  notes              String?
  confirmedAt        DateTime?
  confirmedById      String?
  confirmedBy        User?             @relation("ReservationConfirmedBy", fields: [confirmedById], references: [id])
  rejectedAt         DateTime?
  rejectionReason    String?
  noShowAt           DateTime?
  cancelledAt        DateTime?
  confirmationToken  String            @unique
  idempotencyKey     String?           @unique
  reminderSentAt     DateTime?
  followUpSentAt     DateTime?
  createdAt          DateTime          @default(now())
  session            TableSession?
  emailLogs          EmailLog[]

  @@index([branchId, startsAt])
  @@index([branchId, status])
  @@index([branchId, status, startsAt])
}

model WaitlistEntry {
  id                 String         @id @default(uuid())
  branchId           String
  branch             Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  queueDate          String
  queueNumber        Int
  guestName          String
  guestPhone         String?
  partySize          Int            @default(2)
  preferredSeatType  SeatType?
  preferredTableId   String?
  preferredTable     DiningTable?   @relation("WaitlistPreferredTable", fields: [preferredTableId], references: [id], onDelete: SetNull)
  status             WaitlistStatus @default(WAITING)
  notes              String?
  createdAt          DateTime       @default(now())
  calledAt           DateTime?
  seatedAt           DateTime?
  tableSessionId     String?        @unique

  @@unique([branchId, queueDate, queueNumber])
  @@index([branchId, status, createdAt])
}

model AuditLog {
  id         String   @id @default(uuid())
  createdAt  DateTime @default(now())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id])
  actorRole  Role?
  branchId   String?
  branch     Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  action     String
  entityType String   @map("entity")
  entityId   String
  before     Json?
  after      Json?
  reason     String?
  ip         String?
  meta       Json?

  @@index([createdAt])
  @@index([actorId])
  @@index([action])
  @@index([branchId, createdAt])
  @@index([entityType, entityId])
}

model EmailLog {
  id            String       @id @default(uuid())
  reservationId String
  reservation   Reservation  @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  type          String
  toEmail       String
  status        String       @default("PENDING")
  error         String?
  attempts      Int          @default(0)
  sentAt        DateTime?
  createdAt     DateTime     @default(now())

  @@index([reservationId, type])
  @@index([status, createdAt])
}

enum SoldOutUntilKind {
  INDEFINITE
  END_OF_STORE_DAY
  DATETIME
}

model Category {
  id           String     @id @default(uuid())
  restaurantId String     @default("11111111-1111-4111-8111-111111111111")
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  name         String     @unique
  tagline   String   @default("")
  imageUrl  String   @default("")
  bannerAlt String   @default("")
  sortOrder Int      @default(0)
  isVisible Boolean  @default(true)
  archivedAt DateTime?
  scheduleDays Int[] @default([])
  scheduleStartMinutes Int?
  scheduleEndMinutes   Int?
  defaultPrintStationId String?
  createdAt DateTime @default(now())
}

model MenuItem {
  id            String          @id @default(uuid())
  restaurantId  String          @default("11111111-1111-4111-8111-111111111111")
  restaurant    Restaurant      @relation(fields: [restaurantId], references: [id])
  name          String
  description   String
  price         Decimal         @db.Decimal(10, 2)
  discountPrice Decimal?        @db.Decimal(10, 2)
  category      String
  imageUrl      String
  thumbnailUrl  String          @default("")
  imageWidth    Int?
  imageHeight   Int?
  sku           String?
  tags          String[]        @default([])
  allergens     String[]        @default([])
  prepMinutes   Int?
  sortOrder     Int             @default(0)
  isVisible     Boolean         @default(true)
  isAvailable   Boolean         @default(true)
  archivedAt    DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  orderItems    OrderItem[]
  dealItems     DealItem[]
  sizes         MenuItemSize[]
  addons        MenuItemAddon[]
  optionGroups  MenuItemOptionGroup[]
  recipeLines     RecipeLine[]
  menuRecipe      MenuRecipe?
  wasteLogs       WasteLog[]
  printStationId  String?
  printStation    PrintStation? @relation(fields: [printStationId], references: [id], onDelete: SetNull)
  branchAvailability MenuItemBranchAvailability[]

  @@index([printStationId])
  @@index([category, sortOrder])
  @@index([archivedAt])
  @@index([restaurantId, category, name])
}

model MenuItemBranchAvailability {
  id         String           @id @default(uuid())
  menuItemId String
  menuItem   MenuItem         @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  branchId   String
  branch     Branch           @relation(fields: [branchId], references: [id], onDelete: Cascade)
  soldOut    Boolean          @default(true)
  untilKind  SoldOutUntilKind @default(INDEFINITE)
  untilAt    DateTime?
  reason     String           @default("")
  setById    String?
  setAt      DateTime         @default(now())

  @@unique([menuItemId, branchId])
  @@index([branchId])
}

model PrintStation {
  id        String   @id @default(uuid())
  branchId  String
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  name      String
  code      String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  menuItems MenuItem[]

  @@unique([branchId, code])
  @@index([branchId, isActive, sortOrder])
}

model IngredientCategory {
  id           String     @id @default(uuid())
  restaurantId String     @default("11111111-1111-4111-8111-111111111111")
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  name         String
  sortOrder    Int        @default(0)
  items        InventoryItem[]

  @@unique([restaurantId, name])
}

model Supplier {
  id            String     @id @default(uuid())
  restaurantId  String     @default("11111111-1111-4111-8111-111111111111")
  restaurant    Restaurant @relation(fields: [restaurantId], references: [id])
  name          String
  phone         String     @default("")
  email         String     @default("")
  address       String     @default("")
  paymentTerms  String     @default("")
  notes         String?
  isActive      Boolean    @default(true)
  createdAt     DateTime   @default(now())
  purchases     InventoryPurchase[]
  supplierItems SupplierItem[]

  @@unique([restaurantId, name])
}

model SupplierItem {
  id         String        @id @default(uuid())
  supplierId String
  supplier   Supplier      @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  itemId     String
  item       InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  lastPrice  Decimal       @default(0) @db.Decimal(10, 4)
  updatedAt  DateTime      @updatedAt

  @@unique([supplierId, itemId])
}

model InventoryItem {
  id            String        @id @default(uuid())
  restaurantId  String        @default("11111111-1111-4111-8111-111111111111")
  restaurant    Restaurant    @relation(fields: [restaurantId], references: [id])
  categoryId    String?
  categoryRef   IngredientCategory? @relation(fields: [categoryId], references: [id])
  sku           String?
  name          String
  category      String        @default("General")
  unit          InventoryUnit @default(KG)
  reorderPoint  Decimal       @default(0) @db.Decimal(12, 3)
  parLevel      Decimal?      @db.Decimal(12, 3)
  defaultCost   Decimal       @default(0) @db.Decimal(10, 4)
  trackStock    Boolean       @default(true)
  trackExpiry   Boolean       @default(false)
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  branchStocks  BranchStock[]
  movements     StockMovement[]
  recipeLines   RecipeLine[]
  purchaseLines InventoryPurchaseLine[]
  batches       StockBatch[]
  supplierItems SupplierItem[]
  wasteLogs     WasteLog[]
  countLines    StockCountLine[]
  transferLines StockTransferLine[]

  @@unique([restaurantId, name])
  @@index([restaurantId, category])
  @@index([categoryId])
}

model BranchStock {
  id        String        @id @default(uuid())
  branchId  String
  branch    Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  itemId    String
  item      InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  quantity  Decimal       @default(0) @db.Decimal(12, 3)
  avgCost   Decimal       @default(0) @db.Decimal(10, 4)
  updatedAt DateTime      @updatedAt

  @@unique([branchId, itemId])
}

model StockMovement {
  id              String            @id @default(uuid())
  branchId        String
  branch          Branch            @relation(fields: [branchId], references: [id], onDelete: Cascade)
  itemId          String
  item            InventoryItem     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  type            StockMovementType
  quantityDelta   Decimal           @db.Decimal(12, 3)
  quantityAfter   Decimal           @db.Decimal(12, 3)
  unitCost        Decimal?          @db.Decimal(10, 4)
  reason          String?
  reference       String?
  referenceType   StockReferenceType?
  referenceId     String?
  notes           String?
  actorId         String?
  orderId         String?
  createdAt       DateTime          @default(now())
  purchaseLineId  String?           @unique
  purchaseLine    InventoryPurchaseLine? @relation(fields: [purchaseLineId], references: [id])
  wasteLogId      String?           @unique
  wasteLog        WasteLog?         @relation(fields: [wasteLogId], references: [id])

  @@index([branchId, createdAt])
  @@index([itemId, createdAt])
  @@index([orderId])
  @@index([referenceType, referenceId])
  @@index([actorId])
}

model StockBatch {
  id                String                 @id @default(uuid())
  branchId          String
  branch            Branch                 @relation(fields: [branchId], references: [id], onDelete: Cascade)
  itemId            String
  item              InventoryItem          @relation(fields: [itemId], references: [id], onDelete: Cascade)
  purchaseLineId    String?
  purchaseLine      InventoryPurchaseLine? @relation(fields: [purchaseLineId], references: [id])
  quantityRemaining Decimal                @db.Decimal(12, 3)
  expiryDate        DateTime?
  createdAt         DateTime               @default(now())

  @@index([branchId, itemId])
  @@index([expiryDate])
}

model InventoryPurchase {
  id            String                @id @default(uuid())
  branchId      String
  branch        Branch                @relation(fields: [branchId], references: [id], onDelete: Cascade)
  supplierId    String?
  supplier      Supplier?             @relation(fields: [supplierId], references: [id])
  invoiceRef    String?
  purchaseDate  DateTime              @default(now())
  subtotal      Decimal               @default(0) @db.Decimal(12, 2)
  taxAmount     Decimal               @default(0) @db.Decimal(12, 2)
  discount      Decimal               @default(0) @db.Decimal(12, 2)
  total         Decimal               @default(0) @db.Decimal(12, 2)
  paidAmount    Decimal               @default(0) @db.Decimal(12, 2)
  paymentStatus PurchasePaymentStatus @default(UNPAID)
  status        PurchaseStatus        @default(RECEIVED)
  notes         String?
  createdById   String?
  receivedAt    DateTime              @default(now())
  voidedAt      DateTime?
  createdAt     DateTime              @default(now())
  lines         InventoryPurchaseLine[]
}

model InventoryPurchaseLine {
  id         String            @id @default(uuid())
  purchaseId String
  purchase   InventoryPurchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  itemId     String
  item       InventoryItem     @relation(fields: [itemId], references: [id])
  quantity   Decimal           @db.Decimal(12, 3)
  unitCost   Decimal           @db.Decimal(10, 4)
  lineTotal  Decimal           @default(0) @db.Decimal(12, 2)
  batchNo    String?
  expiryDate DateTime?
  movement   StockMovement?
  batches    StockBatch[]
}

model WasteLog {
  id          String        @id @default(uuid())
  branchId    String
  branch      Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  itemId      String?
  item        InventoryItem? @relation(fields: [itemId], references: [id])
  menuItemId  String?
  menuItem    MenuItem?     @relation(fields: [menuItemId], references: [id])
  quantity    Decimal       @db.Decimal(12, 3)
  reason      WasteReason
  costAtTime  Decimal       @default(0) @db.Decimal(12, 2)
  notes       String?
  loggedAt    DateTime      @default(now())
  createdById String?
  movement    StockMovement?
}

model MenuRecipe {
  id            String   @id @default(uuid())
  menuItemId    String   @unique
  menuItem      MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  yieldPortions Int      @default(1)
  notes         String?
  updatedAt     DateTime @updatedAt
}

model RecipeLine {
  id         String        @id @default(uuid())
  menuItemId String
  menuItem   MenuItem      @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  itemId     String
  item       InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  quantity   Decimal       @db.Decimal(12, 4)

  @@unique([menuItemId, itemId])
}

model StockCount {
  id           String           @id @default(uuid())
  branchId     String
  branch       Branch           @relation(fields: [branchId], references: [id], onDelete: Cascade)
  status       StockCountStatus @default(DRAFT)
  countedById  String?
  approvedById String?
  createdAt    DateTime         @default(now())
  submittedAt  DateTime?
  approvedAt   DateTime?
  lines        StockCountLine[]
}

model StockCountLine {
  id            String        @id @default(uuid())
  countId       String
  count         StockCount    @relation(fields: [countId], references: [id], onDelete: Cascade)
  itemId        String
  item          InventoryItem @relation(fields: [itemId], references: [id])
  systemQty     Decimal       @db.Decimal(12, 3)
  countedQty    Decimal?      @db.Decimal(12, 3)
  variance      Decimal?      @db.Decimal(12, 3)
  varianceCost  Decimal?      @db.Decimal(12, 2)

  @@unique([countId, itemId])
}

model StockTransfer {
  id           String             @id @default(uuid())
  fromBranchId String
  fromBranch   Branch             @relation("TransferFrom", fields: [fromBranchId], references: [id])
  toBranchId   String
  toBranch     Branch             @relation("TransferTo", fields: [toBranchId], references: [id])
  status       TransferStatus     @default(PENDING)
  createdById  String?
  receivedById String?
  createdAt    DateTime           @default(now())
  shippedAt    DateTime?
  receivedAt   DateTime?
  lines        StockTransferLine[]
}

model StockTransferLine {
  id               String        @id @default(uuid())
  transferId       String
  transfer         StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  itemId           String
  item             InventoryItem @relation(fields: [itemId], references: [id])
  quantitySent     Decimal       @db.Decimal(12, 3)
  quantityReceived Decimal?      @db.Decimal(12, 3)

