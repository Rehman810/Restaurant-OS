enum CouponDiscountType {
  PERCENT
  FIXED
}

model Coupon {
  id             String             @id @default(uuid())
  restaurantId   String             @default("11111111-1111-4111-8111-111111111111")
  restaurant     Restaurant         @relation(fields: [restaurantId], references: [id])
  branchId       String?
  branch         Branch?            @relation(fields: [branchId], references: [id], onDelete: SetNull)
  code           String
  name           String             @default("")
  description    String             @default("")
  type           CouponDiscountType
  value          Decimal            @db.Decimal(10, 2)
  minSubtotal    Decimal            @default(0) @db.Decimal(10, 2)
  maxSubtotal    Decimal?           @db.Decimal(10, 2)
  maxDiscount    Decimal?           @db.Decimal(10, 2)
  usageLimit     Int?
  perCustomerLimit Int?
  firstOrderOnly Boolean            @default(false)
  usedCount      Int                @default(0)
  startsAt       DateTime?
  endsAt         DateTime?
  scheduleDays   Int[]              @default([])
  scheduleStartMinutes Int?
  scheduleEndMinutes   Int?
  channelOnline  Boolean            @default(true)
  channelPos     Boolean            @default(true)
  channelDineIn  Boolean            @default(true)
  validDelivery  Boolean            @default(true)
  validPickup    Boolean            @default(true)
  validDineIn    Boolean            @default(true)
  isActive       Boolean            @default(true)
  createdAt      DateTime           @default(now())
  orders         Order[]

  @@unique([restaurantId, code])
  @@index([restaurantId, isActive])
}

enum CashShiftStatus {
  OPEN
  CLOSED
}

enum CashMovementType {
  SALE_CASH
  REFUND_CASH
  PAID_IN
  PAID_OUT
  RIDER_SETTLEMENT
  ADJUSTMENT
}

model CashShift {
  id                   String          @id @default(uuid())
  branchId             String
  branch               Branch          @relation(fields: [branchId], references: [id], onDelete: Cascade)
  cashierId            String
  cashier              User            @relation("CashierShifts", fields: [cashierId], references: [id])
  status               CashShiftStatus @default(OPEN)
  openedAt             DateTime        @default(now())
  closedAt             DateTime?
  openingCash          Decimal         @db.Decimal(10, 2)
  closingCountedCash   Decimal?        @db.Decimal(10, 2)
  closingDenominations Json?
  expectedCash         Decimal?        @db.Decimal(10, 2)
  variance             Decimal?        @db.Decimal(10, 2)
  note                 String?
  closingManagerNote   String?
  movements            CashMovement[]

  @@index([branchId, status])
  @@index([cashierId, status])
  @@index([openedAt])
}

enum RiderCashEntryStatus {
  PENDING
  SETTLED
}

model RiderCashEntry {
  id               String               @id @default(uuid())
  branchId         String
  branch           Branch               @relation(fields: [branchId], references: [id], onDelete: Cascade)
  riderId          String
  rider            User                 @relation("RiderCashEntries", fields: [riderId], references: [id])
  orderId          String                 @unique
  order            Order                  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  expectedAmount   Decimal                @db.Decimal(10, 2)
  collectedAmount  Decimal                @db.Decimal(10, 2)
  varianceReason   String?
  status           RiderCashEntryStatus   @default(PENDING)
  settlementId     String?
  settlement       RiderSettlement?       @relation(fields: [settlementId], references: [id], onDelete: SetNull)
  deliveredAt      DateTime               @default(now())
  settledAt        DateTime?

  @@index([branchId, status, deliveredAt])
  @@index([riderId, status])
}

model RiderSettlement {
  id              String           @id @default(uuid())
  branchId        String
  branch          Branch           @relation(fields: [branchId], references: [id], onDelete: Cascade)
  riderId         String
