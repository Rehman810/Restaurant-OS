generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TenantStatus {
  LEAD
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
  ARCHIVED
}

enum PlanInterval {
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
}

enum PlatformInvoiceStatus {
  DRAFT
  OPEN
  PAID
  VOID
}

enum PlatformPaymentMethod {
  BANK_TRANSFER
  JAZZCASH
  EASYPAISA
  CASH
  CHEQUE
  OTHER
}

enum PlatformRole {
  SUPER_ADMIN
  ADMIN
  BILLING
  SUPPORT
  READONLY
}

enum AnnouncementSeverity {
  INFO
  WARNING
  CRITICAL
}

enum AnnouncementAudience {
  ALL
  PLAN
  STATUS
  TENANTS
}

/// The tenant. Business rows point at this id.
model Restaurant {
  id              String       @id
  hostname        String?      @unique
  slug            String       @unique
  displayName     String       @default("")
  legalName       String       @default("")
  status            TenantStatus @default(ACTIVE)
  statusReason      String       @default("")
  statusChangedAt   DateTime     @default(now())
  deleteScheduledAt DateTime?
  archivedAt        DateTime?
  ownerName       String       @default("")
  ownerEmail      String       @default("")
  ownerPhone      String       @default("")
  city            String       @default("")
  salesOwner      String       @default("")
  tags            String[]     @default([])
  createdAt       DateTime     @default(now())

  settings                   StoreSettings?
  users                      User[]
  categories                 Category[]
  menuItems                  MenuItem[]
  banners                    PromoBanner[]
  deals                      Deal[]
  areas                      DeliveryArea[]
  branches                   Branch[]
  orders                     Order[]
  blocks                     OrderBlock[]
  testimonials               Testimonial[]
  suppliers                  Supplier[]
  inventoryItems             InventoryItem[]
  ingredientCategories       IngredientCategory[]
  coupons                    Coupon[]
  notes                      RestaurantNote[]
  counters                   TenantCounter[]
  branchPosOrderDayCounters  BranchPosOrderDayCounter[]
  taxInvoiceCounters         BranchTaxInvoiceCounter[]
  branchMembers              BranchMember[]
  diningFloors               DiningFloor[]
  diningTables               DiningTable[]
  tableSessions              TableSession[]
  reservations               Reservation[]
  waitlistEntries            WaitlistEntry[]
  auditLogs                  AuditLog[]
  emailLogs                  EmailLog[]
  menuItemBranchAvailability MenuItemBranchAvailability[]
  printStations              PrintStation[]
  supplierPayments           SupplierPayment[]
  supplierItems              SupplierItem[]
  branchStocks               BranchStock[]
  stockMovements             StockMovement[]
  stockBatches               StockBatch[]
  inventoryPurchases         InventoryPurchase[]
  inventoryPurchaseLines     InventoryPurchaseLine[]
  wasteLogs                  WasteLog[]
  menuRecipes                MenuRecipe[]
  recipeLines                RecipeLine[]
  stockCounts                StockCount[]
  stockCountLines            StockCountLine[]
  stockTransfers             StockTransfer[]
  stockTransferLines         StockTransferLine[]
  menuItemOptionGroups       MenuItemOptionGroup[]
  menuItemOptions            MenuItemOption[]
  menuItemSizes              MenuItemSize[]
  menuItemAddons             MenuItemAddon[]
  cashShifts                 CashShift[]
  riderCashEntries           RiderCashEntry[]
  riderSettlements           RiderSettlement[]
  cashMovements              CashMovement[]
  dealBranchAvailability     DealBranchAvailability[]
  dealItems                  DealItem[]
  deliveryAreaBranches       DeliveryAreaBranch[]
  orderPayments              OrderPayment[]
  posHolds                   PosHold[]
  orderFeedback              OrderFeedback[]
  customerPushSubscriptions  CustomerPushSubscription[]
  staffPushSubscriptions     StaffPushSubscription[]
  orderEvents                OrderEvent[]
  orderItems                 OrderItem[]
  kotPrintLogs               KotPrintLog[]
  customerAdminProfiles      CustomerAdminProfile[]
  invoices                   Invoice[]
  deliveryPauses             DeliveryPause[]
  domains                    TenantDomain[]
  subscription               Subscription?
  platformInvoices           PlatformInvoice[]
  platformPayments           PlatformPayment[]
  supportSessions            TenantSupportSession[]
  usageDaily                 TenantUsageDaily[]
  announcementDismissals     AnnouncementDismissal[]
}

/// Time-limited support access token (platform operators only; not exposed on tenant APIs).
model TenantSupportSession {
  id                  String        @id @default(uuid())
  subjectRestaurantId String
  restaurant          Restaurant    @relation(fields: [subjectRestaurantId], references: [id], onDelete: Restrict)
  platformUserId      String
  platformUser        PlatformUser  @relation(fields: [platformUserId], references: [id], onDelete: Restrict)
  tokenHash           String        @unique
  expiresAt           DateTime
  revokedAt           DateTime?
  createdAt           DateTime      @default(now())

  @@index([subjectRestaurantId, expiresAt])
  @@index([platformUserId])
}

/// SaaS plan catalog (platform-owned, not tenant-scoped in the API).
model Plan {
  id           String        @id @default(uuid())
  slug         String        @unique
  name         String
  description  String        @default("")
  interval     PlanInterval  @default(MONTHLY)
  pricePkr     Int           @default(0)
  currency     String        @default("PKR")
  isActive     Boolean       @default(true)
  sortOrder    Int           @default(0)
  entitlements Json          @default("{}")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  subscriptions Subscription[]
}

model Subscription {
  id                 String             @id @default(uuid())
  restaurantId       String             @unique
  restaurant         Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  planId             String
  plan               Plan               @relation(fields: [planId], references: [id], onDelete: Restrict)
  status             SubscriptionStatus @default(TRIALING)
  trialEndsAt        DateTime?
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean            @default(false)
  cancelledAt        DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  invoices           PlatformInvoice[]

  @@index([planId])
  @@index([status])
}

model PlatformInvoice {
  id             String                @id @default(uuid())
  restaurantId   String
  restaurant     Restaurant            @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  subscriptionId String
  subscription   Subscription          @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  invoiceNumber  String
  status         PlatformInvoiceStatus @default(OPEN)
  amountPkr      Int
  currency       String                @default("PKR")
  periodStart    DateTime
  periodEnd      DateTime
  dueAt          DateTime
  paidAt         DateTime?
  notes          String                @default("")
  createdAt      DateTime              @default(now())
  payments       PlatformPayment[]

  @@unique([restaurantId, invoiceNumber])
  @@index([restaurantId, status])
  @@index([subscriptionId])
}

model PlatformPayment {
  id           String                @id @default(uuid())
  restaurantId String
  restaurant   Restaurant            @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  invoiceId    String
  invoice      PlatformInvoice       @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  method       PlatformPaymentMethod
  amountPkr    Int
  reference    String                @default("")
  receivedAt   DateTime
  recordedBy   String                @default("")
  notes        String                @default("")
  createdAt    DateTime              @default(now())

  @@index([restaurantId])
  @@index([invoiceId])
}

/// Platform operator identity (never a tenant User).
model PlatformUser {
  id           String           @id @default(uuid())
  email        String           @unique
  passwordHash String
  name         String
  role         PlatformRole     @default(READONLY)
  isActive     Boolean          @default(true)
  tokenVersion Int              @default(0)
  lastLoginAt  DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  auditLogs        PlatformAuditLog[]
  supportSessions  TenantSupportSession[]
}

/// Append-only log of platform operator actions.
model PlatformAuditLog {
  id              String        @id @default(uuid())
  actorId         String?
  actor           PlatformUser? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorEmail      String        @default("")
  action          String
  entityType      String
  entityId        String
  subjectTenantId String?
  before          Json?
  after           Json?
  ip              String?
  userAgent       String?
  createdAt       DateTime      @default(now())

  @@index([createdAt])
  @@index([subjectTenantId, createdAt])
}

/// Daily usage rollup per tenant (Karachi calendar day).
model TenantUsageDaily {
  id                  String     @id @default(uuid())
  restaurantId        String
  restaurant          Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  usageDate           DateTime   @db.Date
  ordersCount         Int        @default(0)
  bookedPkr           Int        @default(0)
  collectedPkr        Int        @default(0)
  activeStaff         Int        @default(0)
  loginCount          Int        @default(0)
  apiRequests         Int        @default(0)
  failedNotifications Int        @default(0)
  uploadBytes         BigInt     @default(0)
  rowEstimate         Int        @default(0)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  @@unique([restaurantId, usageDate])
  @@index([usageDate])
}

/// Operator broadcast shown in tenant admin (platform-owned).
model PlatformAnnouncement {
  id                 String               @id @default(uuid())
  title              String
  body               String               @default("")
  severity           AnnouncementSeverity @default(INFO)
  audience           AnnouncementAudience @default(ALL)
  audiencePlanSlug   String?
  audienceStatus     TenantStatus?
  audienceTenantIds  String[]             @default([])
  startsAt           DateTime
  endsAt             DateTime?
  dismissible        Boolean              @default(true)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  dismissals         AnnouncementDismissal[]

  @@index([startsAt, endsAt])
}

model AnnouncementDismissal {
  id             String               @id @default(uuid())
  announcementId String
  announcement   PlatformAnnouncement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  restaurantId   String
  restaurant     Restaurant           @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  dismissedAt    DateTime             @default(now())

  @@unique([announcementId, restaurantId])
  @@index([restaurantId])
}

/// Singleton platform configuration (versioned optimistic locking).
model PlatformSettings {
  id        String   @id @default("default")
  version   Int      @default(1)
  data      Json     @default("{}")
  updatedAt DateTime @updatedAt
}

/// Last run metadata for in-process platform jobs.
model PlatformJobRun {
  jobKey         String    @id
  lastStartedAt  DateTime?
  lastFinishedAt DateTime?
  lastSuccessAt  DateTime?
  lastError      String?
}

/// Custom hostname mapped to a tenant (e.g. orders.client.com).
model TenantDomain {
  id           String     @id @default(uuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  hostname     String     @unique
  isPrimary    Boolean    @default(false)
  verifiedAt   DateTime?
  createdAt    DateTime   @default(now())

  @@index([restaurantId])
}

/// Operator notes about a tenant. Not exposed on tenant APIs.
model RestaurantNote {
  id           String     @id @default(uuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  body         String
  createdAt    DateTime   @default(now())

  @@index([restaurantId, createdAt])
}

/// Gap-free per-tenant sequences. Allocation takes a row lock.
model TenantCounter {
  id           String     @id @default(uuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  branchId     String     @default("")
  name         String
  periodKey    String     @default("")
  lastValue    Int        @default(0)

  @@unique([restaurantId, branchId, name, periodKey])
  @@index([restaurantId])
}

model Branch {
  id                   String                       @id @default(uuid())
  restaurantId         String                       @default("11111111-1111-4111-8111-111111111111")
  restaurant           Restaurant                   @relation(fields: [restaurantId], references: [id])
  name                 String
  code                 String
  address              String                       @default("")
  addressLine          String                       @default("")
  area                 String                       @default("")
  city                 String                       @default("")
  latitude             Float?
  longitude            Float?
  email                String?
  managerUserId        String?
  managerUser          User?                        @relation("BranchManager", fields: [managerUserId], references: [id], onDelete: SetNull)
  phone                String                       @default("")
  acceptsOnlineOrders  Boolean                      @default(true)
  isActive             Boolean                      @default(true)
  deactivatedAt        DateTime?
  isDefault            Boolean                      @default(false)
  sortOrder            Int                          @default(0)
  timezone             String                       @default("Asia/Karachi")
  graceMin             Int                          @default(15)
  createdAt            DateTime                     @default(now())
  orders               Order[]
  auditLogs            AuditLog[]
  members              BranchMember[]
  diningFloors         DiningFloor[]
  diningTables         DiningTable[]
  tableSessions        TableSession[]
  reservations         Reservation[]
  waitlistEntries      WaitlistEntry[]
  branchStocks         BranchStock[]
  stockMovements       StockMovement[]
  inventoryPurchases   InventoryPurchase[]
  supplierPayments     SupplierPayment[]
  stockBatches         StockBatch[]
  wasteLogs            WasteLog[]
  stockCounts          StockCount[]
  transfersOut         StockTransfer[]              @relation("TransferFrom")
  transfersIn          StockTransfer[]              @relation("TransferTo")
  cashShifts           CashShift[]
  riderCashEntries     RiderCashEntry[]
  riderSettlements     RiderSettlement[]
  printStations        PrintStation[]
  branchCoupons        Coupon[]
  posOrderDayCounters  BranchPosOrderDayCounter[]
  taxInvoiceCounters   BranchTaxInvoiceCounter[]
  posHolds             PosHold[]
  menuItemAvailability MenuItemBranchAvailability[]
  dealAvailability     DealBranchAvailability[]
  deliveryAreaLinks    DeliveryAreaBranch[]

  @@unique([restaurantId, code])
  @@index([restaurantId, isActive])
}

model BranchPosOrderDayCounter {
  id           String     @id @default(uuid())
  restaurantId String     @default("11111111-1111-4111-8111-111111111111")
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  branchId     String
  branch       Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)
  dayKey       String
  lastSeq      Int        @default(1000)

  @@unique([branchId, dayKey])
  @@index([restaurantId])
}

model BranchTaxInvoiceCounter {
  id           String     @id @default(uuid())
  restaurantId String     @default("11111111-1111-4111-8111-111111111111")
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  branchId     String
  branch       Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)
  fiscalYear   Int        @default(0)
  lastSeq      Int        @default(0)

  @@unique([branchId, fiscalYear])
  @@index([restaurantId])
}

enum FiscalSubmissionStatus {
  NOT_REQUIRED
  PENDING
  SUBMITTED
  FAILED
}

model BranchMember {
  id           String     @id @default(uuid())
  restaurantId String     @default("11111111-1111-4111-8111-111111111111")
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  branchId     String
  branch       Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([branchId, userId])
  @@index([userId])
  @@index([restaurantId])
}

enum Role {
  CUSTOMER
  ADMIN
  MANAGER
  WAITER
  RIDER
  CHEF
  CASHIER
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  NEEDS_CLEANING
}

enum SeatType {
  TABLE
  TAKHT
  BOOTH
  HIGH_TOP
  OUTDOOR
}

enum TableSessionStatus {
  OPEN
  CLOSED
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  REJECTED
  SEATED
  CANCELLED
  NO_SHOW
  COMPLETED
}

enum WaitlistStatus {
  WAITING
  CALLED
  SEATED
  CANCELLED
  LEFT
}

enum InventoryUnit {
  KG
  G
  L
  ML
  PIECE
  PACK
  DOZEN
}

enum StockMovementType {
  PURCHASE
  ADJUSTMENT
  WASTE
  SALE
  SALE_DEDUCTION
  COUNT
  COUNT_CORRECTION
  TRANSFER_IN
  TRANSFER_OUT
  REVERSAL
}

enum PurchasePaymentStatus {
  UNPAID
  PARTIAL
  PAID
}

enum PurchaseStatus {
  DRAFT
  RECEIVED
  VOIDED
}

enum WasteReason {
  EXPIRED
  SPOILED
  DROPPED
  OVER_PREPARED
  STAFF_MEAL
  OTHER
}

enum StockCountStatus {
  DRAFT
  SUBMITTED
  APPROVED
}

enum TransferStatus {
  PENDING
  IN_TRANSIT
  RECEIVED
  CANCELLED
}

enum StockReferenceType {
  ORDER
  PURCHASE
  WASTE
  COUNT
  TRANSFER
  ADJUSTMENT
}

enum OrderSource {
  ONLINE
  POS
}

enum PaymentMethod {
  CASH
  CARD
}

enum OrderStatus {
  PENDING_CONFIRMATION
  CONFIRMED
  PREPARING
  READY
  OUT_FOR_DELIVERY
  DELIVERED
  COLLECTED
  SERVED
  CANCELLED
}

enum FulfillmentType {
  DELIVERY
  PICKUP
  DINE_IN
}

model User {
  id                     String     @id @default(uuid())
  restaurantId           String     @default("11111111-1111-4111-8111-111111111111")
  restaurant             Restaurant @relation(fields: [restaurantId], references: [id])
  name                   String
  email                  String
  passwordHash           String
  role                   Role
  phone                  String?
  isActive               Boolean    @default(true)
  isTest                 Boolean    @default(false)
  isOwner                Boolean    @default(false)
  totpSecret             String?
  totpEnabled            Boolean    @default(false)
  recoveryCodes          String?
  tokenVersion           Int        @default(0)
  failedLoginCount       Int        @default(0)
  lockedUntil            DateTime?
  approvalPinHash        String?
  approvalPinFailedCount Int        @default(0)
  approvalPinLockedUntil DateTime?
  lastLoginAt            DateTime?
  passwordResetToken     String?
  passwordResetExpires   DateTime?
  createdAt              DateTime   @default(now())

  orders                    Order[]                    @relation("CustomerOrders")
  assignedOrders            Order[]                    @relation("RiderOrders")
  posOrders                 Order[]                    @relation("PosOrders")
  waiterOrders              Order[]                    @relation("WaiterOrders")
  waiterSessions            TableSession[]             @relation("WaiterSessions")
  branchMembers             BranchMember[]
  managedBranches           Branch[]                   @relation("BranchManager")
  confirmedReservations     Reservation[]              @relation("ReservationConfirmedBy")
  auditLogs                 AuditLog[]
  ordersAdjustmentRequested Order[]                    @relation("OrderAdjRequester")
  ordersAdjustmentApproved  Order[]                    @relation("OrderAdjApprover")
  ordersVoidApproved        Order[]                    @relation("OrderVoidApprover")
  ordersRefundApproved      Order[]                    @relation("OrderRefundApprover")
  cashShifts                CashShift[]                @relation("CashierShifts")
  cashMovementsCreated      CashMovement[]             @relation("CashMovementCreator")
  riderCashEntries          RiderCashEntry[]           @relation("RiderCashEntries")
  riderSettlementsReceived  RiderSettlement[]          @relation("RiderSettlementsRider")
  riderSettlementsSettled   RiderSettlement[]          @relation("RiderSettlementsSettledBy")
  loyaltyPoints             Int                        @default(0)
  pushSubscriptions         CustomerPushSubscription[]
  staffPushSubscriptions    StaffPushSubscription[]
  posHolds                  PosHold[]
  deliveryPauses            DeliveryPause[]            @relation("DeliveryPauses")

  @@unique([restaurantId, email])
  @@index([restaurantId])
}

model DiningFloor {
  id           String        @id @default(uuid())
  restaurantId String        @default("11111111-1111-4111-8111-111111111111")
  restaurant   Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  branchId     String
  branch       Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  name         String
  sortOrder    Int           @default(0)
  createdAt    DateTime      @default(now())
  tables       DiningTable[]

  @@unique([branchId, name])
  @@index([branchId, sortOrder])
  @@index([restaurantId])
}

model DiningTable {
  id                String          @id @default(uuid())
  restaurantId      String          @default("11111111-1111-4111-8111-111111111111")
  restaurant        Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  branchId          String
  branch            Branch          @relation(fields: [branchId], references: [id], onDelete: Cascade)
  floorId           String?
  floor             DiningFloor?    @relation(fields: [floorId], references: [id], onDelete: SetNull)
  label             String
  capacity          Int             @default(4)
  seatType          SeatType        @default(TABLE)
  zone              String          @default("")
  status            TableStatus     @default(AVAILABLE)
  sortOrder         Int             @default(0)
  createdAt         DateTime        @default(now())
  sessions          TableSession[]
  reservations      Reservation[]
  orders            Order[]
  waitlistPreferred WaitlistEntry[] @relation("WaitlistPreferredTable")

  @@unique([branchId, label])
  @@index([branchId, status])
  @@index([floorId])
  @@index([restaurantId])
}

model TableSession {
  id            String             @id @default(uuid())
  restaurantId  String             @default("11111111-1111-4111-8111-111111111111")
  restaurant    Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  branchId      String
  branch        Branch             @relation(fields: [branchId], references: [id], onDelete: Cascade)
  tableId       String
  table         DiningTable        @relation(fields: [tableId], references: [id], onDelete: Cascade)
  waiterId      String?
  waiter        User?              @relation("WaiterSessions", fields: [waiterId], references: [id])
  guestName     String             @default("Walk-in")
  partySize     Int                @default(2)
  status        TableSessionStatus @default(OPEN)
  notes         String?
  openedAt      DateTime           @default(now())
  closedAt      DateTime?
  reservationId String?            @unique
  reservation   Reservation?       @relation(fields: [reservationId], references: [id])
  orders        Order[]

  @@index([branchId, status])
  @@index([tableId, status])
  @@index([restaurantId])
}

model Reservation {
  id                 String            @id @default(uuid())
  restaurantId       String            @default("11111111-1111-4111-8111-111111111111")
  restaurant         Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  branchId           String
  branch             Branch            @relation(fields: [branchId], references: [id], onDelete: Cascade)
  tableId            String?
  table              DiningTable?      @relation(fields: [tableId], references: [id])
  guestName          String
  guestPhone         String
  guestEmail         String
  emailMissingLegacy Boolean           @default(false)
  partySize          Int               @default(2)
  startsAt           DateTime
  durationMin        Int               @default(90)
  status             ReservationStatus @default(PENDING)
  notes              String?
  confirmedAt        DateTime?
  confirmedById      String?
  confirmedBy        User?             @relation("ReservationConfirmedBy", fields: [confirmedById], references: [id])
  rejectedAt         DateTime?
  rejectionReason    String?
  noShowAt           DateTime?
  cancelledAt        DateTime?
  confirmationToken  String            @unique
  idempotencyKey     String?
  reminderSentAt     DateTime?
  followUpSentAt     DateTime?
  createdAt          DateTime          @default(now())
  session            TableSession?
  emailLogs          EmailLog[]

  @@unique([restaurantId, idempotencyKey])
  @@index([branchId, startsAt])
  @@index([branchId, status])
  @@index([branchId, status, startsAt])
  @@index([restaurantId])
}

model WaitlistEntry {
  id                String         @id @default(uuid())
  restaurantId      String         @default("11111111-1111-4111-8111-111111111111")
  restaurant        Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  branchId          String
  branch            Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  queueDate         String
  queueNumber       Int
  guestName         String
  guestPhone        String?
  partySize         Int            @default(2)
  preferredSeatType SeatType?
  preferredTableId  String?
  preferredTable    DiningTable?   @relation("WaitlistPreferredTable", fields: [preferredTableId], references: [id], onDelete: SetNull)
  status            WaitlistStatus @default(WAITING)
  notes             String?
  createdAt         DateTime       @default(now())
  calledAt          DateTime?
  seatedAt          DateTime?
  tableSessionId    String?        @unique

  @@unique([branchId, queueDate, queueNumber])
  @@index([branchId, status, createdAt])
  @@index([restaurantId])
}

model AuditLog {
  id           String     @id @default(uuid())
  restaurantId String     @default("11111111-1111-4111-8111-111111111111")
